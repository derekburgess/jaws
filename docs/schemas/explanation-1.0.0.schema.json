{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaws.local/schemas/explanation-1.0.0.schema.json",
  "title": "JAWS Finding Explanation 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_id",
    "rank",
    "score",
    "reasons",
    "evidence",
    "infrastructure_caveat"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "entity_id": {"type": "string", "minLength": 1},
    "rank": {"type": "integer", "minimum": 1},
    "score": {"type": "number"},
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature", "value", "unit", "direction", "standardized_deviation",
          "weighted_deviation", "comparison_frame", "baseline", "baseline_depth",
          "host_relative"
        ],
        "properties": {
          "feature": {"type": "string"},
          "value": {"type": "number"},
          "unit": {"type": "string"},
          "direction": {"enum": ["high", "low"]},
          "standardized_deviation": {"type": "number"},
          "weighted_deviation": {"type": "number", "minimum": 0},
          "comparison_frame": {"enum": ["peer endpoints", "own history"]},
          "baseline": {"type": ["number", "null"]},
          "baseline_depth": {"type": "integer", "minimum": 0},
          "host_relative": {"type": ["string", "null"]}
        }
      }
    },
    "evidence": {"type": "array", "minItems": 1},
    "infrastructure_caveat": {"type": ["string", "null"]}
  }
}
