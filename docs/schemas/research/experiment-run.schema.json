{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaws.dev/schemas/research/experiment-run-1.0.0.json",
  "properties": {
    "artifacts": {"type": "array"},
    "completed_stages": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "created_at": {"format": "date-time", "type": "string"},
    "experiment_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "failure": {"type": ["object", "null"]},
    "run_id": {"minLength": 1, "type": "string"},
    "schema_version": {"const": "1.0.0"},
    "specification_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "state": {"enum": ["planned", "queued", "running", "completed", "failed", "cancelled", "superseded"]},
    "transitions": {"items": {"type": "object"}, "minItems": 1, "type": "array"}
  },
  "required": ["schema_version", "run_id", "experiment_id", "specification_digest", "state", "created_at", "completed_stages", "artifacts", "transitions"],
  "title": "ExperimentRun 1.0.0",
  "type": "object"
}
