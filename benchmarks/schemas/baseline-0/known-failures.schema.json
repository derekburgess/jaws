{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/derekburgess/jaws/benchmarks/schemas/baseline-0/known-failures.schema.json",
  "title": "JAWS Benchmark 0 known detector-quality failures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "failures"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_kind": {
      "const": "known_failures"
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure"
      }
    }
  },
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_id",
        "title",
        "status",
        "scenario_ids",
        "evaluation_surface",
        "first_observed_revision",
        "expected_rule",
        "observed_behavior",
        "rationale",
        "regression_guard"
      ],
      "properties": {
        "failure_id": {
          "type": "string",
          "pattern": "^BF0-KF-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "accepted"
          ]
        },
        "scenario_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evaluation_surface": {
          "type": "string",
          "enum": [
            "endpoints",
            "host_outbound"
          ]
        },
        "first_observed_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "expected_rule": {
          "type": "string",
          "minLength": 1
        },
        "observed_behavior": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "regression_guard": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
