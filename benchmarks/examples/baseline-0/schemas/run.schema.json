{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/derekburgess/jaws/benchmarks/schemas/baseline-0/run.schema.json",
  "title": "JAWS Benchmark 0 execution run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "run_id",
    "benchmark_id",
    "lifecycle",
    "invocation",
    "analytical_modes",
    "dependencies",
    "scenario_statuses"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_kind": {
      "const": "run"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "benchmark_id": {
      "const": "baseline-0"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "started_at",
        "ended_at",
        "duration_ms"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "skipped"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "exit_code",
        "stdout_artifact",
        "stderr_artifact"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout_artifact": {
          "type": "string",
          "minLength": 1
        },
        "stderr_artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analytical_modes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "state",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "text-only",
              "numeric-only",
              "blended"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "used",
              "not_used",
              "unavailable",
              "unsupported"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "state",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "used",
              "not_used",
              "unavailable",
              "unsupported"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "scenario_statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario_status"
      }
    }
  },
  "$defs": {
    "scenario_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "execution_status",
        "quality_outcome",
        "duration_ms",
        "error",
        "skip_reason"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "skipped"
          ]
        },
        "quality_outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed_known",
            "failed_unexpected",
            "not_evaluated"
          ]
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "skip_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "quality_outcome": {
                "enum": [
                  "passed",
                  "failed_known",
                  "failed_unexpected"
                ]
              },
              "error": {
                "type": "null"
              },
              "skip_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "quality_outcome": {
                "const": "not_evaluated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "string",
                "minLength": 1
              },
              "skip_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_status": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              },
              "skip_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
