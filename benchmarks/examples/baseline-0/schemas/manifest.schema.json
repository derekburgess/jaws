{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/derekburgess/jaws/benchmarks/schemas/baseline-0/manifest.schema.json",
  "title": "JAWS Benchmark 0 bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "benchmark",
    "subject",
    "collector",
    "commands",
    "schema_catalog",
    "artifacts",
    "conventions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_kind": {
      "const": "manifest"
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "title",
        "canonical",
        "created_at",
        "description"
      ],
      "properties": {
        "benchmark_id": {
          "const": "baseline-0"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "detector_files"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "detector_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/digested_path"
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "working_tree_dirty",
        "source_sha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{7,64}|worktree)$"
        },
        "working_tree_dirty": {
          "type": "boolean"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "argv",
          "cwd",
          "environment"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/safe_environment_variable"
            }
          }
        }
      }
    },
    "schema_catalog": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_kind",
          "path",
          "schema_version"
        ],
        "properties": {
          "artifact_kind": {
            "type": "string",
            "enum": [
              "manifest",
              "dataset_catalog",
              "scenario_catalog",
              "run",
              "environment",
              "ranking",
              "evaluation",
              "known_failures"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^schemas/[A-Za-z0-9._/-]+\\.schema\\.json$"
          },
          "schema_version": {
            "const": "1.0.0"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "media_type",
          "required"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "role": {
            "type": "string",
            "enum": [
              "manifest",
              "dataset_catalog",
              "scenario_catalog",
              "run",
              "environment",
              "rankings",
              "evaluation",
              "known_failures",
              "schema",
              "stdout",
              "stderr",
              "report",
              "checksums"
            ]
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank_base",
        "emitted_position_base",
        "score_order",
        "timestamp_format",
        "null_policy",
        "secret_policy",
        "checksum_algorithm"
      ],
      "properties": {
        "rank_base": {
          "const": 1
        },
        "emitted_position_base": {
          "const": 0
        },
        "score_order": {
          "const": "descending"
        },
        "timestamp_format": {
          "const": "RFC3339-UTC"
        },
        "null_policy": {
          "type": "string",
          "minLength": 1
        },
        "secret_policy": {
          "type": "string",
          "minLength": 1
        },
        "checksum_algorithm": {
          "const": "sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digested_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "safe_environment_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "state": {
          "type": "string",
          "enum": [
            "unset",
            "set-with-value-redacted"
          ]
        }
      }
    }
  }
}
