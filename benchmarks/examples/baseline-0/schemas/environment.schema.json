{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/derekburgess/jaws/benchmarks/schemas/baseline-0/environment.schema.json",
  "title": "JAWS Benchmark 0 environment provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "captured_at",
    "python",
    "platform",
    "hardware",
    "packages",
    "tools",
    "services",
    "models",
    "containers",
    "environment_variables"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_kind": {
      "const": "environment"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "executable"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "release",
        "machine"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_cpu_count",
        "memory_bytes",
        "gpu"
      ],
      "properties": {
        "logical_cpu_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "devices"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "used",
                "not_used",
                "unavailable"
              ]
            },
            "devices": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_method",
        "items"
      ],
      "properties": {
        "capture_method": {
          "const": "importlib.metadata"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versioned_dependency"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versioned_dependency"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "state",
          "provider",
          "model",
          "revision",
          "digest"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "$ref": "#/$defs/dependency_state"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition",
          "state",
          "sha256",
          "base_images"
        ],
        "properties": {
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "$ref": "#/$defs/dependency_state"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "base_images": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "environment_variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "state"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "state": {
            "type": "string",
            "enum": [
              "unset",
              "set-with-value-redacted"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "dependency_state": {
      "type": "string",
      "enum": [
        "used",
        "not_used",
        "unavailable",
        "unsupported"
      ]
    },
    "versioned_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/dependency_state"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
