{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/derekburgess/jaws/benchmarks/schemas/baseline-0/scenario.schema.json",
  "title": "JAWS Benchmark 0 scenario catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_kind": {
      "const": "scenario_catalog"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "nullable_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_version",
        "dataset_id",
        "source_type",
        "generator",
        "packet_rows_sha256",
        "packet_count",
        "observation_window",
        "target",
        "expectation",
        "evaluation_surface",
        "seeds",
        "history",
        "success_rule",
        "note"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "scenario_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "synthetic",
            "pcap"
          ]
        },
        "generator": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "qualified_name",
                "source_sha256",
                "parameters"
              ],
              "properties": {
                "qualified_name": {
                  "type": "string",
                  "minLength": 1
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "integer",
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            }
          ]
        },
        "packet_rows_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "packet_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capture_id",
            "start_offset_seconds",
            "duration_seconds",
            "host_perspective"
          ],
          "properties": {
            "capture_id": {
              "type": "string",
              "minLength": 1
            },
            "start_offset_seconds": {
              "type": "number"
            },
            "duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "host_perspective": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entity_type",
                "entity_id"
              ],
              "properties": {
                "entity_type": {
                  "const": "endpoint-ip"
                },
                "entity_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "target": {
          "$ref": "#/$defs/entity"
        },
        "expectation": {
          "type": "string",
          "enum": [
            "detect",
            "reject"
          ]
        },
        "evaluation_surface": {
          "type": "string",
          "enum": [
            "endpoints",
            "host_outbound"
          ]
        },
        "seeds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "scenario"
          ],
          "properties": {
            "background": {
              "type": [
                "integer",
                "null"
              ]
            },
            "scenario": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prior_sessions",
            "scales",
            "background_seed_rule",
            "sessions"
          ],
          "properties": {
            "prior_sessions": {
              "type": "integer",
              "minimum": 0
            },
            "scales": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "background_seed_rule": {
              "type": [
                "string",
                "null"
              ]
            },
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capture_id",
                  "start_offset_seconds",
                  "scale",
                  "background_seed",
                  "packet_count",
                  "packet_rows_sha256"
                ],
                "properties": {
                  "capture_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start_offset_seconds": {
                    "type": "number"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "background_seed": {
                    "type": "integer"
                  },
                  "packet_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "packet_rows_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "success_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "operator",
            "threshold",
            "rank_base"
          ],
          "properties": {
            "metric": {
              "const": "target_rank"
            },
            "operator": {
              "type": "string",
              "enum": [
                "<=",
                ">"
              ]
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "rank_base": {
              "const": 1
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type",
        "entity_id"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "endpoint-ip",
            "host-destination"
          ]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
