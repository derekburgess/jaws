{
  "mcpServers": {
    "JAWS": {
      "type": "stdio",
      "command": "python",
      "args": ["/path/to/jaws/jaws_mcp/server.py", "--stdio"],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "<your neo4j password>",
        "IPINFO_API_KEY": "<your ipinfo api key>"
      }
    }
  }
}
